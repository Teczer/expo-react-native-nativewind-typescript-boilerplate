{
  "name": "expo-nativewind-typescript-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bunx expo start -c",
    "dev": "bunx expo start --dev-client -c",
    "android": "bun expo run:android",
    "android:prebuild": "npx expo prebuild && bun expo run:android",
    "ios": "bun expo run:ios",
    "ios:prebuild": "npx expo prebuild && bun expo run:ios",
    "web": "bun run expo start --web",
    "test": "bun run jest --watchAll",
    "format": "bun run prettier --write .",
    "format:check": "bun run prettier --check .",
    "clean": "rm -rf node_modules .expo ios android",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.101.4",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@dev-plugins/react-native-mmkv": "0.4.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
